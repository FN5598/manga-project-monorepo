{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm exec tsx watch ./src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --verbose --runInBand",
    "start": "node ./dist/server.js",
    "dev:build-compose": "docker compose up --build -d",
    "dev:shutdown": "docker compose down -v && docker compose ps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express4": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1006.0",
    "@aws-sdk/s3-request-presigner": "^3.1006.0",
    "@typegoose/typegoose": "^13.2.1",
    "argon2": "^0.44.0",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "~4.22.1",
    "graphql": "^16.13.1",
    "jose": "^6.2.2",
    "mongoose": "^9.2.3",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "2.0.0-rc.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.3.3",
    "eslint": "^10.2.1",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser@>=5.0.0 <5.5.6": ">=5.5.6",
      "@apollo/server@<5.5.0": ">=5.5.0",
      "path-to-regexp@<0.1.13": ">=0.1.13",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "fast-xml-parser@>=5.0.0 <5.5.7": ">=5.5.7",
      "fast-xml-parser@<5.7.0": ">=5.7.0",
      "uuid@<14.0.0": ">=14.0.0"
    }
  }
}
